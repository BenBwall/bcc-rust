# Lexing snapshots record diagnostic output byte for byte, including empty
# source lines and the blank separator at the end of a rendered diagnostic.
tests/fixtures/lexing/directives_and_macros.snap whitespace=-blank-at-eof
tests/fixtures/lexing/test_programs.snap whitespace=-trailing-space
# GCC-format diagnostic goldens end with the blank line that separates
# rendered diagnostics, as GCC's format has no closing summary line.
tests/fixtures/diagnostics/sema-permerrors-gcc.stderr whitespace=-blank-at-eof
tests/fixtures/diagnostics/sema-permerrors-gnu89.stderr whitespace=-blank-at-eof
tests/fixtures/diagnostics/sema-permerrors-permissive.stderr whitespace=-blank-at-eof

# PDFs are binary, even linearized ones that Git would detect as text: never
# convert their line endings or diff them as text.
*.pdf binary
