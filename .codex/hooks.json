{
  "description": "agentbus: deliver messages from other agents working in this repository",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$env:RUSTFLAGS = ' '; cargo run --quiet --manifest-path \"$(git rev-parse --show-toplevel)/scripts/agentbus/Cargo.toml\" -- hook --agent codex", "timeout": 60, "additionalContextLimit": 8000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$env:RUSTFLAGS = ' '; cargo run --quiet --manifest-path \"$(git rev-parse --show-toplevel)/scripts/agentbus/Cargo.toml\" -- hook --agent codex", "timeout": 60, "additionalContextLimit": 8000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "$env:RUSTFLAGS = ' '; cargo run --quiet --manifest-path \"$(git rev-parse --show-toplevel)/scripts/agentbus/Cargo.toml\" -- hook --agent codex", "timeout": 60, "additionalContextLimit": 8000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$env:RUSTFLAGS = ' '; cargo run --quiet --manifest-path \"$(git rev-parse --show-toplevel)/scripts/agentbus/Cargo.toml\" -- hook --agent codex", "timeout": 3600 }
        ]
      }
    ]
  }
}
