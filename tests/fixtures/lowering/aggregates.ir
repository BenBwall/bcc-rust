; struct pair { long a; double b; };
; struct three { char c[3]; };
; struct big { int x[10]; };
; struct pair bump(struct pair p) { struct pair r = p; r.a = p.a + 1; return r; }
; int first(struct three t, struct big b) { return t.c[2] + b.x[0]; }
; long use(struct pair p) {
;   struct pair q = bump(bump(p));
;   struct big b = { { 3 } };
;   struct three k = { { 1, 2, 3 } };
;   return q.a + first(k, b) + bump(p).a;
; }
; union u { float f; int i; char c[3]; };
; union u pass(union u v) { return v; }

target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @bump(ptr result(size 16, align 8, [0: i64, 8: f64]), ptr aggregate(size 16, align 8, [0: i64, 8: f64]) noundef) external {
    slot0 = stack_slot 16, align 8
block0(v0: ptr, v1: ptr):
    v2 = stack_addr slot0
    v3 = iconst.i64 16
    copy may_overlap v2, v1, v3, align 8
    v4 = stack_addr slot0
    v5 = load.i64 v1, align 8
    v6 = iconst.i32 1
    v7 = iconst.i64 1
    v8 = iadd.i64 nsw v5, v7
    store.i64 v8, v4, align 8
    v9 = stack_addr slot0
    v10 = iconst.i64 16
    copy v0, v9, v10, align 8
    return
}

function @first(ptr aggregate(size 3, align 1, [0: i8, 1: i8, 2: i8]) noundef, ptr aggregate(size 40, align 4) noundef) -> i32 external {
block0(v0: ptr, v1: ptr):
    v2 = iconst.i32 2
    v3 = iconst.i64 2
    v4 = ptr_add inbounds v0, v3
    v5 = load.i8 v4, align 1
    v6 = sext.i32 v5
    v7 = iconst.i32 0
    v8 = load.i32 v1, align 4
    v9 = iadd.i32 nsw v6, v8
    return v9
}

function @use(ptr aggregate(size 16, align 8, [0: i64, 8: f64]) noundef) -> i64 external {
    slot0 = stack_slot 16, align 8
    slot1 = stack_slot 16, align 8
    slot2 = stack_slot 16, align 8
    slot3 = stack_slot 16, align 8
    slot4 = stack_slot 16, align 8
    slot5 = stack_slot 40, align 4
    slot6 = stack_slot 3, align 1
    slot7 = stack_slot 3, align 1
    slot8 = stack_slot 40, align 4
    slot9 = stack_slot 16, align 8
    slot10 = stack_slot 16, align 8
block0(v0: ptr):
    v1 = stack_addr slot1
    v2 = iconst.i64 16
    copy v1, v0, v2, align 8
    v3 = stack_addr slot2
    call @bump(v3, v1)
    v4 = stack_addr slot3
    v5 = iconst.i64 16
    copy v4, v3, v5, align 8
    v6 = stack_addr slot4
    call @bump(v6, v4)
    v7 = stack_addr slot0
    v8 = iconst.i64 16
    copy may_overlap v7, v6, v8, align 8
    v9 = stack_addr slot5
    v10 = iconst.i64 4
    v11 = ptr_add inbounds v9, v10
    v12 = iconst.i8 0
    v13 = iconst.i64 36
    fill v11, v12, v13, align 1
    v14 = iconst.i32 3
    v15 = stack_addr slot5
    store.i32 v14, v15, align 4
    v16 = iconst.i32 1
    v17 = iconst.i8 1
    v18 = stack_addr slot6
    store.i8 v17, v18, align 1
    v19 = iconst.i32 2
    v20 = iconst.i8 2
    v21 = stack_addr slot6
    v22 = iconst.i64 1
    v23 = ptr_add inbounds v21, v22
    store.i8 v20, v23, align 1
    v24 = iconst.i32 3
    v25 = iconst.i8 3
    v26 = stack_addr slot6
    v27 = iconst.i64 2
    v28 = ptr_add inbounds v26, v27
    store.i8 v25, v28, align 1
    v29 = stack_addr slot0
    v30 = load.i64 v29, align 8
    v31 = stack_addr slot6
    v32 = stack_addr slot7
    v33 = iconst.i64 3
    copy v32, v31, v33, align 1
    v34 = stack_addr slot5
    v35 = stack_addr slot8
    v36 = iconst.i64 40
    copy v35, v34, v36, align 4
    v37 = call @first(v32, v35)
    v38 = sext.i64 v37
    v39 = iadd.i64 nsw v30, v38
    v40 = stack_addr slot9
    v41 = iconst.i64 16
    copy v40, v0, v41, align 8
    v42 = stack_addr slot10
    call @bump(v42, v40)
    v43 = load.i64 v42, align 8
    v44 = iadd.i64 nsw v39, v43
    return v44
}

function @pass(ptr result(size 4, align 4, [0: f32, 0: i32, 0: i8, 1: i8, 2: i8]), ptr aggregate(size 4, align 4, [0: f32, 0: i32, 0: i8, 1: i8, 2: i8]) noundef) external {
block0(v0: ptr, v1: ptr):
    v2 = iconst.i64 4
    copy v0, v1, v2, align 4
    return
}
