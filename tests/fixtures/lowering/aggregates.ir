; struct pair { long a; double b; };
; struct three { char c[3]; };
; struct big { int x[10]; };
; struct pair bump(struct pair p) { struct pair r = p; r.a = p.a + 1; return r; }
; int first(struct three t, struct big b) { return t.c[2] + b.x[0]; }
; long use(struct pair p) {
;   struct pair q = bump(bump(p));
;   struct big b = { { 3 } };
;   struct three k = { { 1, 2, 3 } };
;   return q.a + first(k, b) + bump(p).a;
; }
; union u { float f; int i; char c[3]; };
; union u pass(union u v) { return v; }

target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @bump(ptr result(size 16, align 8, [0: i64, 8: f64]), ptr aggregate(size 16, align 8, [0: i64, 8: f64])) external {
    slot0 = stack_slot 16, align 8
block0(v0: ptr, v1: ptr):
    v2 = stack_addr slot0
    v3 = iconst.i8 0
    v4 = iconst.i64 16
    fill v2, v3, v4, align 8
    v5 = stack_addr slot0
    v6 = iconst.i64 16
    copy may_overlap v5, v1, v6, align 8
    v7 = stack_addr slot0
    v8 = load.i64 v1, align 8
    v9 = iconst.i32 1
    v10 = iconst.i64 1
    v11 = iadd.i64 nsw v8, v10
    store.i64 v11, v7, align 8
    v12 = stack_addr slot0
    v13 = iconst.i64 16
    copy v0, v12, v13, align 8
    return
}

function @first(ptr aggregate(size 3, align 1, [0: i8, 1: i8, 2: i8]), ptr aggregate(size 40, align 4)) -> i32 external {
block0(v0: ptr, v1: ptr):
    v2 = iconst.i32 2
    v3 = iconst.i64 2
    v4 = ptr_add inbounds v0, v3
    v5 = load.i8 v4, align 1
    v6 = sext.i32 v5
    v7 = iconst.i32 0
    v8 = load.i32 v1, align 4
    v9 = iadd.i32 nsw v6, v8
    return v9
}

function @use(ptr aggregate(size 16, align 8, [0: i64, 8: f64])) -> i64 external {
    slot0 = stack_slot 16, align 8
    slot1 = stack_slot 16, align 8
    slot2 = stack_slot 16, align 8
    slot3 = stack_slot 16, align 8
    slot4 = stack_slot 16, align 8
    slot5 = stack_slot 40, align 4
    slot6 = stack_slot 3, align 1
    slot7 = stack_slot 3, align 1
    slot8 = stack_slot 40, align 4
    slot9 = stack_slot 16, align 8
    slot10 = stack_slot 16, align 8
block0(v0: ptr):
    v1 = stack_addr slot0
    v2 = iconst.i8 0
    v3 = iconst.i64 16
    fill v1, v2, v3, align 8
    v4 = stack_addr slot1
    v5 = stack_addr slot2
    v6 = iconst.i64 16
    copy v5, v0, v6, align 8
    call @bump(v4, v5)
    v7 = stack_addr slot3
    v8 = stack_addr slot4
    v9 = iconst.i64 16
    copy v8, v4, v9, align 8
    call @bump(v7, v8)
    v10 = stack_addr slot0
    v11 = iconst.i64 16
    copy may_overlap v10, v7, v11, align 8
    v12 = stack_addr slot5
    v13 = iconst.i8 0
    v14 = iconst.i64 40
    fill v12, v13, v14, align 4
    v15 = iconst.i32 3
    v16 = stack_addr slot5
    store.i32 v15, v16, align 4
    v17 = stack_addr slot6
    v18 = iconst.i8 0
    v19 = iconst.i64 3
    fill v17, v18, v19, align 1
    v20 = iconst.i32 1
    v21 = iconst.i8 1
    v22 = stack_addr slot6
    store.i8 v21, v22, align 1
    v23 = iconst.i32 2
    v24 = iconst.i8 2
    v25 = stack_addr slot6
    v26 = iconst.i64 1
    v27 = ptr_add inbounds v25, v26
    store.i8 v24, v27, align 1
    v28 = iconst.i32 3
    v29 = iconst.i8 3
    v30 = stack_addr slot6
    v31 = iconst.i64 2
    v32 = ptr_add inbounds v30, v31
    store.i8 v29, v32, align 1
    v33 = stack_addr slot0
    v34 = load.i64 v33, align 8
    v35 = stack_addr slot6
    v36 = stack_addr slot5
    v37 = stack_addr slot7
    v38 = iconst.i64 3
    copy v37, v35, v38, align 1
    v39 = stack_addr slot8
    v40 = iconst.i64 40
    copy v39, v36, v40, align 4
    v41 = call @first(v37, v39)
    v42 = sext.i64 v41
    v43 = iadd.i64 nsw v34, v42
    v44 = stack_addr slot9
    v45 = stack_addr slot10
    v46 = iconst.i64 16
    copy v45, v0, v46, align 8
    call @bump(v44, v45)
    v47 = load.i64 v44, align 8
    v48 = iadd.i64 nsw v43, v47
    return v48
}

function @pass(ptr result(size 4, align 4, [0: f32, 0: i32, 0: i8, 1: i8, 2: i8]), ptr aggregate(size 4, align 4, [0: f32, 0: i32, 0: i8, 1: i8, 2: i8])) external {
block0(v0: ptr, v1: ptr):
    v2 = iconst.i64 4
    copy v0, v1, v2, align 4
    return
}
