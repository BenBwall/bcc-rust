target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @f(f64, f32, i32) -> f64 external {
block0(v0: f64, v1: f32, v2: i32):
    v3 = fconst.f64 0x3FF0000000000000
    v4 = fadd.f64 v0, v3
    v5 = fconst.f32 0x3F800000
    v6 = fsub.f32 v1, v5
    v7 = iconst.i32 1
    v8 = fconst.f64 0x3FF0000000000000
    v9 = fadd.f64 v4, v8
    v10 = sitofp.f64 v2
    v11 = fconst.f64 0x3FF8000000000000
    v12 = fadd.f64 v10, v11
    v13 = fptosi.i32 v12
    v14 = sitofp.f32 v13
    v15 = fmul.f32 v6, v14
    v16 = sitofp.f32 v13
    v17 = fconst.f32 0x3F000000
    v18 = fdiv.f32 v16, v17
    v19 = fptosi.i32 v18
    v20 = fpext.f64 v15
    v21 = fadd.f64 v9, v20
    v22 = sitofp.f64 v19
    v23 = fadd.f64 v21, v22
    return v23
}
