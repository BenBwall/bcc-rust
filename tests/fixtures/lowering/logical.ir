; int f(int);
; int both(int a, int b) { return a && f(b); }
; int either(int a, int b) { return a || f(b); }
; int pick(int c, int a, long b) { return c ? a : b; }
; int not(int a) { return !a; }
; int branch(int a, int b) { if (a > 0 && (b < 0 || !a)) return 1; return 0; }

target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @both(i32, i32) -> i32 external {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    v3 = icmp.i32 ne v0, v2
    v4 = iconst.i1 0
    brif v3, block1, block2(v4)
block1:
    v5 = call @f(v1)
    v6 = iconst.i32 0
    v7 = icmp.i32 ne v5, v6
    jump block2(v7)
block2(v8: i1):
    v9 = zext.i32 v8
    return v9
}

function @either(i32, i32) -> i32 external {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    v3 = icmp.i32 ne v0, v2
    v4 = iconst.i1 1
    brif v3, block2(v4), block1
block1:
    v5 = call @f(v1)
    v6 = iconst.i32 0
    v7 = icmp.i32 ne v5, v6
    jump block2(v7)
block2(v8: i1):
    v9 = zext.i32 v8
    return v9
}

function @pick(i32, i32, i64) -> i32 external {
block0(v0: i32, v1: i32, v2: i64):
    v3 = iconst.i32 0
    v4 = icmp.i32 ne v0, v3
    brif v4, block1, block2
block1:
    v5 = sext.i64 v1
    jump block3(v5)
block2:
    jump block3(v2)
block3(v6: i64):
    v7 = trunc.i32 v6
    return v7
}

function @not(i32) -> i32 external {
block0(v0: i32):
    v1 = iconst.i32 0
    v2 = icmp.i32 eq v0, v1
    v3 = zext.i32 v2
    return v3
}

function @branch(i32, i32) -> i32 external {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    v3 = icmp.i32 sgt v0, v2
    brif v3, block1, block4
block1:
    v4 = iconst.i32 0
    v5 = icmp.i32 slt v1, v4
    brif v5, block3, block2
block2:
    v6 = iconst.i32 0
    v7 = icmp.i32 ne v0, v6
    brif v7, block4, block3
block3:
    v8 = iconst.i32 1
    return v8
block4:
    v9 = iconst.i32 0
    return v9
}

function @f(i32) -> i32 external
