target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @sum(i32) -> i32 external {
block0(v0: i32):
    v1 = iconst.i32 0
    v2 = iconst.i32 0
    jump block1(v2, v1)
block1(v3: i32, v4: i32):
    v5 = icmp.i32 slt v3, v0
    brif v5, block2, block8
block2:
    v6 = iconst.i32 3
    v7 = icmp.i32 eq v3, v6
    brif v7, block3, block4
block3:
    jump block7(v4)
block4:
    v8 = iconst.i32 100
    v9 = icmp.i32 sgt v3, v8
    brif v9, block5, block6
block5:
    jump block8
block6:
    v10 = iadd.i32 nsw v4, v3
    jump block7(v10)
block7(v11: i32):
    v12 = iconst.i32 1
    v13 = iadd.i32 nsw v3, v12
    jump block1(v13, v11)
block8:
    v14 = iconst.i32 0
    jump block9(v14)
block9(v15: i32):
    v16 = icmp.i32 slt v15, v0
    brif v16, block10, block11
block10:
    v17 = iconst.i32 2
    v18 = iadd.i32 nsw v15, v17
    jump block9(v18)
block11:
    jump block12(v4)
block12(v19: i32):
    v20 = iconst.i32 1
    v21 = isub.i32 nsw v19, v20
    jump block13
block13:
    v22 = iconst.i32 50
    v23 = icmp.i32 sgt v21, v22
    brif v23, block12(v21), block14
block14:
    jump block15(v21)
block15(v24: i32):
    jump block16
block16:
    v25 = iconst.i32 0
    v26 = icmp.i32 ne v24, v25
    brif v26, block17, block19
block17:
    jump block18
block18:
    v27 = iadd.i32 nsw v24, v15
    return v27
block19:
    v28 = iconst.i32 1
    jump block20
block20:
    jump block15(v28)
}
