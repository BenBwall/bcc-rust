;   for (int i = 0; i < n; i++) {
;     if (i == 3) continue;
;     if (i > 100) break;
;     s += i;
;   }
;   int j = 0;
;   while (j < n) j += 2;
;   do { s--; } while (s > 50);
;   for (;;) { if (s) break; s = 1; }
