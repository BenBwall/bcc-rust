; double table[3] = { 1.5, 2, -0.25 };
; float single = 3.14159f;
; long double wide = 1.0L / 3;
; int truncated = 2.75;
; _Bool flag = 0.5;
; struct s { float f; double d; } s = { 1, 2.5f };
; double read(void) {
;   double local[2] = { 1, 2.5 };
;   float f = 0.1f;
;   struct s t = { f, local[1] };
;   return local[0] + f + t.d;
; }

target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

global @table external size 24, align 16 = bytes "000000000000f83f0000000000000040000000000000d0bf"
global @single external size 4, align 4 = bytes "d00f4940"
global @wide external size 16, align 16 = bytes "abaaaaaaaaaaaaaafd3f000000000000"
global @truncated external size 4, align 4 = bytes "02000000"
global @flag external size 1, align 1 = bytes "01"
global @s external size 16, align 8 = bytes "0000803f000000000000000000000440"

function @read() -> f64 external {
    slot0 = stack_slot 16, align 16
    slot1 = stack_slot 16, align 8
block0:
    v0 = iconst.i32 1
    v1 = fconst.f64 0x3FF0000000000000
    v2 = stack_addr slot0
    store.f64 v1, v2, align 16
    v3 = fconst.f64 0x4004000000000000
    v4 = stack_addr slot0
    v5 = iconst.i64 8
    v6 = ptr_add inbounds v4, v5
    store.f64 v3, v6, align 8
    v7 = fconst.f32 0x3DCCCCCD
    v8 = stack_addr slot1
    v9 = iconst.i64 4
    v10 = ptr_add inbounds v8, v9
    v11 = iconst.i8 0
    v12 = iconst.i64 4
    fill v10, v11, v12, align 4
    v13 = stack_addr slot1
    store.f32 v7, v13, align 8
    v14 = stack_addr slot0
    v15 = iconst.i32 1
    v16 = iconst.i64 8
    v17 = ptr_add inbounds v14, v16
    v18 = load.f64 v17, align 8
    v19 = stack_addr slot1
    v20 = iconst.i64 8
    v21 = ptr_add inbounds v19, v20
    store.f64 v18, v21, align 8
    v22 = stack_addr slot0
    v23 = iconst.i32 0
    v24 = load.f64 v22, align 16
    v25 = fpext.f64 v7
    v26 = fadd.f64 v24, v25
    v27 = stack_addr slot1
    v28 = iconst.i64 8
    v29 = ptr_add inbounds v27, v28
    v30 = load.f64 v29, align 8
    v31 = fadd.f64 v26, v30
    return v31
}
