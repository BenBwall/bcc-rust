target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @f(i32, i8, i32, ptr) -> i32 external {
block0(v0: i32, v1: i8, v2: i32, v3: ptr):
    v4 = iadd.i32 v0, v2
    v5 = sext.i32 v1
    v6 = iconst.i32 3
    v7 = imul.i32 nsw v5, v6
    v8 = trunc.i8 v7
    v9 = sext.i32 v8
    v10 = shl.i32 nsw v9, v0
    v11 = trunc.i8 v10
    v12 = iconst.i32 2
    v13 = iconst.i64 8
    v14 = ptr_add inbounds v3, v13
    v15 = sext.i64 v0
    v16 = iconst.i64 4
    v17 = imul.i64 nsw v15, v16
    v18 = iconst.i64 0
    v19 = isub.i64 nsw v18, v17
    v20 = ptr_add inbounds v14, v19
    v21 = sext.i32 v11
    store.i32 v21, v20, align 4
    return v21
}
