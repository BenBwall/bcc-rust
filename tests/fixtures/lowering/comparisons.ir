; int sless(int a, int b) { return a < b; }
; int uless(unsigned a, unsigned b) { return a <= b; }
; int mixed(int a, unsigned b) { return a > b; }
; int pointers(int *p, int *q) { return (p < q) + (p == q) + (p != 0) + !p; }
; int chars(char c, unsigned char u) { return c >= u; }

target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @sless(i32, i32) -> i32 external {
block0(v0: i32, v1: i32):
    v2 = icmp.i32 slt v0, v1
    v3 = zext.i32 v2
    return v3
}

function @uless(i32, i32) -> i32 external {
block0(v0: i32, v1: i32):
    v2 = icmp.i32 ule v0, v1
    v3 = zext.i32 v2
    return v3
}

function @mixed(i32, i32) -> i32 external {
block0(v0: i32, v1: i32):
    v2 = icmp.i32 ugt v0, v1
    v3 = zext.i32 v2
    return v3
}

function @pointers(ptr, ptr) -> i32 external {
block0(v0: ptr, v1: ptr):
    v2 = icmp.ptr ult v0, v1
    v3 = zext.i32 v2
    v4 = icmp.ptr eq v0, v1
    v5 = zext.i32 v4
    v6 = iadd.i32 nsw v3, v5
    v7 = iconst.i32 0
    v8 = null
    v9 = icmp.ptr ne v0, v8
    v10 = zext.i32 v9
    v11 = iadd.i32 nsw v6, v10
    v12 = null
    v13 = icmp.ptr eq v0, v12
    v14 = zext.i32 v13
    v15 = iadd.i32 nsw v11, v14
    return v15
}

function @chars(i8, i8) -> i32 external {
block0(v0: i8, v1: i8):
    v2 = sext.i32 v0
    v3 = zext.i32 v1
    v4 = icmp.i32 sge v2, v3
    v5 = zext.i32 v4
    return v5
}
