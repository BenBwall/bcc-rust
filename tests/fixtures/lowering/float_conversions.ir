; int truncate(double d) { return (int)d; }
; unsigned long to_unsigned(float f) { return (unsigned long)f; }
; char to_char(double d) { return (char)d; }
; double from_signed(int i, long l) { return i + (double)l; }
; double from_unsigned(unsigned u, unsigned long ul) { return u + (double)ul; }
; float to_float(long l, _Bool b) { return l + b; }
; double widen(float f) { return f; }
; _Bool truth(double d) { return d; }
; double from_constant(void) { return 7; }

target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

function @truncate(f64 noundef) -> i32 external {
block0(v0: f64):
    v1 = fptosi.i32 v0
    return v1
}

function @to_unsigned(f32 noundef) -> i64 external {
block0(v0: f32):
    v1 = fptoui.i64 v0
    return v1
}

function @to_char(f64 noundef) -> i8 signed external {
block0(v0: f64):
    v1 = fptosi.i8 v0
    return v1
}

function @from_signed(i32 noundef, i64 noundef) -> f64 external {
block0(v0: i32, v1: i64):
    v2 = sitofp.f64 v0
    v3 = sitofp.f64 v1
    v4 = fadd.f64 v2, v3
    return v4
}

function @from_unsigned(i32 noundef, i64 noundef) -> f64 external {
block0(v0: i32, v1: i64):
    v2 = uitofp.f64 v0
    v3 = uitofp.f64 v1
    v4 = fadd.f64 v2, v3
    return v4
}

function @to_float(i64 noundef, i8 bool noundef) -> f32 external {
block0(v0: i64, v1: i8):
    v2 = zext.i64 v1
    v3 = iadd.i64 nsw v0, v2
    v4 = sitofp.f32 v3
    return v4
}

function @widen(f32 noundef) -> f64 external {
block0(v0: f32):
    v1 = fpext.f64 v0
    return v1
}

function @truth(f64 noundef) -> i8 bool external {
block0(v0: f64):
    v1 = fconst.f64 0x0000000000000000
    v2 = fcmp.f64 une v0, v1
    v3 = zext.i8 v2
    return v3
}

function @from_constant() -> f64 external {
block0:
    v0 = iconst.i32 7
    v1 = fconst.f64 0x401C000000000000
    return v1
}
