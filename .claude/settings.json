{
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "0"
  },
  "enabledMcpjsonServers": ["agentbus"],
  "permissions": {
    "allow": ["mcp__agentbus", "Workflow"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "RUSTFLAGS='' cargo run --quiet --manifest-path \"$CLAUDE_PROJECT_DIR/scripts/agentbus/Cargo.toml\" -- hook --agent claude", "timeout": 60 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "RUSTFLAGS='' cargo run --quiet --manifest-path \"$CLAUDE_PROJECT_DIR/scripts/agentbus/Cargo.toml\" -- hook --agent claude", "timeout": 60 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "RUSTFLAGS='' cargo run --quiet --manifest-path \"$CLAUDE_PROJECT_DIR/scripts/agentbus/Cargo.toml\" -- hook --agent claude", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "RUSTFLAGS='' cargo run --quiet --manifest-path \"$CLAUDE_PROJECT_DIR/scripts/agentbus/Cargo.toml\" -- hook --agent claude", "timeout": 3600 }
        ]
      }
    ]
  }
}
